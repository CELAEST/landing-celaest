{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celaest-landing",
  "compatibility_date": "2026-11-09",
  "main": "./worker.js",
  "vars": {
    "EMAIL_FROM": "CELAEST <noreply@celaest.com>",
    "EMAIL_INTERNAL_RECEIVER": "celaest.oficial@gmail.com"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/data/*",
      "!/images/*",
      "!/icons/*",
      "!/brand/*",
      "!/robot_hero_gaze/*",
      "!/robot_hero_saludo/*"
    ]
  }
}
