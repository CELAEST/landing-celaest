# ==============================================================================
# ENTORNO DE PRODUCCIÓN ENTERPRISE - VARIABLES DE ENTORNO
# ==============================================================================

# Base URL para resolución de Metadata Canónica
NEXT_PUBLIC_BASE_URL="https://celaest.com"

# 1. Analíticas Comerciales (Métricas de Tráfico y Conversión)
# Reemplazar con los IDs reales proporcionados por el equipo de Marketing
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX" # Google Analytics 4
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="celaest.com"   # Plausible Analytics

# 2. Application Performance Monitoring (Sentry / LogRocket)
# Reemplazar con el DSN real para capturar JavaScript Crashes en tiempo real
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX"

# 3. Datos Legales de Empresa (Inyectados en Términos Dinámicos)
NEXT_PUBLIC_COMPANY_NAME="Celaest Inc."
NEXT_PUBLIC_CONTACT_EMAIL="legal@celaest.com"

# 4. Endpoints de SaaS Core (Pasarela externa B2B)
NEXT_PUBLIC_SAAS_DASHBOARD_URL="https://app.celaest.com"

# 5. Celaest Backend API (used by /pricing section for geo-localized prices)
# Must point to the public Celaest API. The endpoint
#   GET {NEXT_PUBLIC_CELAEST_API_URL}/api/v1/public/pricing/resolve?country=XX
# is hit on the client to fetch local-currency plan prices.
# Falls back to translation defaults (USD) when this is unset or unreachable.
NEXT_PUBLIC_CELAEST_API_URL="https://api.celaest.com"
